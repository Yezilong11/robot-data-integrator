# 复制此文件为 .env 并填入真实值
# .env 文件已在 .gitignore 中，不会提交到仓库

# 千问模型
QWEN_API_KEY=sk-your-api-key-here
QWEN_MODEL=qwen-plus
QWEN_EMBEDDING_MODEL=text-embedding-v3

# GitHub
GITHUB_TOKEN=ghp-your-github-token-here

# IEEE
IEEE_API_KEY=your-ieee-api-key-here

# Adapter
ADAPTER_TIMEOUT=30.0
ADAPTER_MAX_RETRY=3
ADAPTER_RATE_LIMIT=10
ADAPTER_CACHE_TTL=3600

# ChromaDB
CHROMADB_PATH=./data/experience_db

# 输出
OUTPUT_DIR=./data/output_packages

# 日志
LOG_LEVEL=INFO
LOG_FORMAT=json