# .env 文件已在 .gitignore 中，不会提交到仓库

# LLM（OpenAI 兼容；切换厂商只改 LLM_BASE_URL）
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_EMBEDDING_MODEL=text-embedding-v3

# GitHub
GITHUB_TOKEN=ghp-your-github-token-here

# IEEE
IEEE_API_KEY=your-ieee-api-key-here

# HuggingFace（可选：国内可设镜像站加速）
HF_ENDPOINT=https://hf-mirror.com

# Adapter
ADAPTER_TIMEOUT=30.0
ADAPTER_MAX_RETRY=3
ADAPTER_RATE_LIMIT=10
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=256

# ChromaDB
CHROMADB_PATH=./data/experience_db

# 输出
OUTPUT_DIR=./data/output_packages

# 日志
LOG_LEVEL=INFO
LOG_FORMAT=json
